.env
models.json
# 全量批次临时矩阵（由 models.json 改 limit=0 生成），不入库
models.full.json
# 重跑 invalid 模型的临时矩阵，不入库
models.rerun2.json
.venv/
__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/
*.egg-info/
build/
dist/

# 本地沙箱与运行产物
workspace/
reports/runs/
# 补跑/定向重跑的结果单独归档，不与正式批次并列进图表
reports/reruns/
reports/batch-*/
# reports/charts/ 有意入库：README 直接引用图与离线看板，批量重跑后重新生成再提交
reports/partial_results*.jsonl
reports/latest.md
reports/observability.json

# 本地数据备份包与归档目录，不入库
.reports-backup-*.zip
.reports-archive-*/
.workspace-archive-*/

# 重判临时目录：备份与运行日志
.rejudge_backup/
.rejudge_logs/

# 后台跑批的 nohup 合并日志（本地临时产物，不入库）
batch-*.log

# 覆盖率产物：本地跑 pytest --cov 时生成，不进库
.coverage
coverage.json
