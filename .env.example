# ---- 被测 Agent（SUT）----
AQG_BASE_URL=https://your-openai-compatible-endpoint/v1
AQG_MODEL=your-model-name
AQG_MODEL_VERSION=
AQG_API_KEY=
# 兼容旧变量名：未设置 AQG_API_KEY 时会读取 GC_API_KEY

# ---- 裁判模型（可选，默认复用被测模型）----
AQG_JUDGE_BASE_URL=
AQG_JUDGE_MODEL=
AQG_JUDGE_API_KEY=

# ---- 本地模型端点（可选，仅 S3 用例需要）----
AQG_LOCAL_BASE_URL=
AQG_LOCAL_MODEL=
AQG_LOCAL_API_KEY=

# ---- 用例生成脚本（可选）----
# .env 中不要写 Python 表达式，只写字面量或 ${已有环境变量名} 插值
AQG_GEN_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
AQG_GEN_MODEL=GLM-5.2
# 二选一：直接填 key，或从 shell 已有的环境变量插值（需先 export LK_DS_API_KEY）
AQG_GEN_API_KEY=${LK_DS_API_KEY}

# ---- 批量串行评测（scripts/run_batch.py）----
# 方式一：指向模型清单文件（推荐，格式见 models.example.json）
# AQG_MODEL_MATRIX=models.json
# 方式二：内联多个模型，用 ; 分隔，格式 name|model|base_url|KEY_ENV
# AQG_MODELS=glm-5.2|GLM-5.2|https://chatapi.weixin.qq.com/openai/v1|GLM_API_KEY
